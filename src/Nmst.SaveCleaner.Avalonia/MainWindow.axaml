<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nmst.SaveCleaner.ViewModels;assembly=Nmst.SaveCleaner.ViewModels"
        xmlns:core="clr-namespace:Nmst.SaveCleaner.Core;assembly=Nmst.SaveCleaner.Core"
        xmlns:local="clr-namespace:Nmst.SaveCleaner.Avalonia"
        x:Class="Nmst.SaveCleaner.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NMST Modded Save Cleaner · Cyberpunk 2077"
        Width="1440" Height="900" MinWidth="1200" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="-1">
  <Panel x:Name="Root">
    <DockPanel>

      <!-- top bar = the window's title bar: drag to move, double-click to maximise. Always usable, even during the
           disclaimer and dialogs; only the app buttons in it are disabled then -->
      <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              Padding="16,9,10,9" PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="avares://NMSTSaveCleaner/Assets/Icon/app-64.png" Width="34" Height="34" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="brand" Text="NMST MODDED SAVE CLEANER" FontSize="15" />
              <TextBlock Classes="faint" FontSize="12">
                <!-- one line: a line break between Runs renders as an extra space -->
                <Run Text="No Modded Save Tag · Cyberpunk 2077 · " /><Run Text="{x:Static local:App.VersionLabel}" Foreground="{StaticResource Cyan}" />
              </TextBlock>
            </StackPanel>
          </StackPanel>
          <!-- column 1 stays empty: free space to grab and drag the window -->
          <StackPanel x:Name="AppButtons" Grid.Column="2" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding DisclaimerAccepted}">
            <Button Classes="icon" ToolTip.Tip="strifehart.com"
                    Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static core:AppInfo.SiteUrl}">
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Classes="glyph" Stroke="{StaticResource Pink}" StrokeThickness="1.8" Data="M5 13 A7 7 0 0 1 19 13" />
                  <Path Classes="glyph" Stroke="{StaticResource Pink}" StrokeThickness="1.2" Data="M6 10.5 H18 M7.5 8 H16.5" />
                  <Path Classes="glyph" Stroke="{StaticResource Cyan}" StrokeThickness="1.3"
                        Data="M2 13 H22 M12 13 L12 21 M12 13 L5 21 M12 13 L19 21 M12 13 L1 18 M12 13 L23 18 M3.5 17 H20.5" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Classes="icon" ToolTip.Tip="strifehart on Nexus Mods"
                    Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static core:AppInfo.NexusProfileUrl}">
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Classes="glyph" Stroke="{StaticResource Cyan}" Data="M12 2.5 L20.5 7 V17 L12 21.5 L3.5 17 V7 Z M3.5 7 L12 11.5 L20.5 7 M12 11.5 V21.5" />
                  <Path Classes="glyph" Stroke="{StaticResource Pink}" Data="M7.8 4.8 L16.2 9.2" />
                </Canvas>
              </Viewbox>
            </Button>
            <Border Width="1" Background="{StaticResource Line}" Margin="4,4" />
            <Button Content="Change folder" Command="{Binding ChangeFolderCommand}" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" />
            <Button x:Name="BackupsButton" Content="Backups">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" Opening="OnBackupsMenuOpening">
                  <StackPanel Spacing="10" MinWidth="260">
                    <TextBlock Classes="label" Text="BACKUPS" />
                    <TextBlock Text="{Binding BackupsSummary}" FontWeight="SemiBold" />
                    <Button Classes="link" Content="Clean up backups…" Command="{Binding CleanUpBackupsCommand}" Click="OnBackupsMenuItemClick"
                            />
                    <Button Classes="link" Content="{Binding TrashMenuText}" Command="{Binding OpenTrashCommand}" Click="OnBackupsMenuItemClick" />
                    <Button Classes="link" Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}" Click="OnBackupsMenuItemClick"
                            ToolTip.Tip="{Binding BackupsRoot}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Command="{Binding ToggleLogCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Log" />
                <Border Background="#2200e5ff" CornerRadius="3" Padding="5,0">
                  <TextBlock Text="{Binding LogCount}" FontSize="12" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- window buttons; hidden where the platform keeps its own title bar (some Linux window managers) -->
          <StackPanel x:Name="WindowButtons" Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="14,-9,-10,-9" VerticalAlignment="Stretch">
            <Button Classes="caption" Click="OnMinimiseClick" ToolTip.Tip="Minimise">
              <Path Classes="glyph" Stroke="{StaticResource Muted}" Data="M0 6 H12" Width="12" Height="12" />
            </Button>
            <Button Classes="caption" Click="OnMaximiseClick" ToolTip.Tip="Maximise / restore">
              <Panel>
                <Path x:Name="MaxGlyph" Classes="glyph" Stroke="{StaticResource Muted}" Data="M0.5 0.5 H11.5 V11.5 H0.5 Z" Width="12" Height="12" />
                <Path x:Name="RestoreGlyph" Classes="glyph" Stroke="{StaticResource Muted}" IsVisible="False"
                      Data="M0.5 3.5 H8.5 V11.5 H0.5 Z M3.5 3.5 V0.5 H11.5 V8.5 H8.5" Width="12" Height="12" />
              </Panel>
            </Button>
            <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="Close">
              <Path Classes="glyph" Stroke="{StaticResource Muted}" Data="M0.5 0.5 L11.5 11.5 M11.5 0.5 L0.5 11.5" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- everything below the title bar; the disclaimer and dialogs cover only this part -->
      <Panel>
    <DockPanel IsEnabled="{Binding DisclaimerAccepted}">

      <!-- status bar -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,5">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" MinHeight="22">
          <!-- counts first, then the saves folder (the folder trims if space runs out) -->
          <TextBlock Classes="faint" Text="{Binding StatusLine}" VerticalAlignment="Center" />
          <DockPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <Button DockPanel.Dock="Right" Classes="link" Content="Use default" Margin="10,0,0,0" IsVisible="{Binding IsCustomFolder}"
                    Command="{Binding UseDefaultFolderCommand}" ToolTip.Tip="Go back to the detected Saved Games folder" />
            <TextBlock Classes="mono" Foreground="{StaticResource Faint}" FontSize="11" Text="{Binding SavesFolder}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SavesFolder}" />
          </DockPanel>
          <!-- result of the last action: fades out after a few seconds; errors stay red until clicked -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" IsVisible="{Binding !IsBusy}"
                      Opacity="{Binding ResultVisible, Converter={StaticResource BoolToOpacity}}" IsHitTestVisible="{Binding ResultVisible}">
            <Button Classes="result" Classes.error="{Binding ResultIsError}" Content="{Binding ResultText}"
                    Command="{Binding DismissResultCommand}" ToolTip.Tip="Click to dismiss" VerticalAlignment="Center" />
            <Button Classes="link" Content="Undo" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding ResultCanUndo}"
                    Command="{Binding UndoLastBatchCommand}" ToolTip.Tip="Undo this" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
            <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource PinkSoft}" FontSize="13" VerticalAlignment="Center" />
            <Border Width="240" Height="8" CornerRadius="4" ClipToBounds="True" Background="{StaticResource CardHi}" VerticalAlignment="Center">
              <Panel>
                <ProgressBar Value="{Binding Progress}" Maximum="1" Foreground="{StaticResource NeonGradient}" Background="Transparent"
                             MinHeight="8" Height="8" CornerRadius="4">
                  <!-- glide to each new value instead of jumping, so even a one-step job visibly fills -->
                  <ProgressBar.Transitions>
                    <Transitions><DoubleTransition Property="Value" Duration="0:0:0.9" Easing="CubicEaseOut" /></Transitions>
                  </ProgressBar.Transitions>
                </ProgressBar>
                <Border Classes="shimmer" Width="70" HorizontalAlignment="Left">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0" Color="#00ffffff" />
                      <GradientStop Offset="0.5" Color="#88ffffff" />
                      <GradientStop Offset="1" Color="#00ffffff" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                </Border>
              </Panel>
            </Border>
          </StackPanel>
          <!-- mini player: pause/play, track, thin progress; clicking the track opens the full player above it -->
          <StackPanel x:Name="MiniPlayer" Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding MusicAvailable}">
            <Button Classes="link" Margin="0" Command="{Binding PlayPauseCommand}" IsVisible="{Binding !MusicMuted}" ToolTip.Tip="Pause / play">
              <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                <Path Classes="glyph" Stroke="{StaticResource PinkSoft}" StrokeThickness="4" IsVisible="{Binding !IsMusicPaused}" Data="M8 4 V20 M16 4 V20" />
                <Path Classes="glyph" Stroke="{StaticResource PinkSoft}" Fill="{StaticResource PinkSoft}" IsVisible="{Binding IsMusicPaused}" Data="M7 4 L20 12 L7 20 Z" />
              </Canvas></Viewbox>
            </Button>
            <Button Classes="link" Margin="0" Command="{Binding ToggleMusicPanelCommand}" ToolTip.Tip="Music player">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="13" Height="13" IsVisible="{Binding MusicMuted}"><Canvas Width="24" Height="24">
                  <Path Classes="glyph" Stroke="{StaticResource Pink}" Data="M4 9.5 H8 L13 5.5 V18.5 L8 14.5 H4 Z M16 9.5 L21 14.5 M21 9.5 L16 14.5" />
                </Canvas></Viewbox>
                <TextBlock Text="{Binding MiniPlayerTitle}" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{StaticResource PinkSoft}" />
                <Border Width="56" Height="3" CornerRadius="2" ClipToBounds="True" Background="{StaticResource CardHi}" VerticalAlignment="Center"
                        IsVisible="{Binding !MusicMuted}">
                  <ProgressBar Value="{Binding TrackProgress}" Maximum="1" Foreground="{StaticResource NeonGradient}" Background="Transparent"
                               MinHeight="3" Height="3" />
                </Border>
                <TextBlock Text="▴" IsVisible="{Binding !IsMusicPanelOpen}" VerticalAlignment="Center" />
                <TextBlock Text="▾" IsVisible="{Binding IsMusicPanelOpen}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <!-- opens the docked log above the status bar -->
          <Button Grid.Column="5" Classes="link" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding ToggleLogCommand}"
                  ToolTip.Tip="Show or hide the processing log">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="LOG" FontFamily="{StaticResource HeadFont}" FontSize="10" LetterSpacing="1.2" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LogCount}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="▴" IsVisible="{Binding !IsLogOpen}" VerticalAlignment="Center" />
              <TextBlock Text="▾" IsVisible="{Binding IsLogOpen}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- docked processing log: slides up from the status bar; drag its top edge to resize; can pop out to a window -->
      <Border x:Name="LogDrawer" DockPanel.Dock="Bottom" Height="0" ClipToBounds="True" Background="#0a0811"
              BorderBrush="{StaticResource Purple}" BorderThickness="0,1,0,0">
        <Border.Transitions>
          <Transitions><DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut" /></Transitions>
        </Border.Transitions>
        <DockPanel>
          <Border x:Name="LogResizeHandle" DockPanel.Dock="Top" Height="6" Background="Transparent" Cursor="SizeNorthSouth"
                  PointerPressed="OnLogResizePressed" PointerMoved="OnLogResizeMoved" PointerReleased="OnLogResizeReleased" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="18,0,12,6">
            <TextBlock Classes="h2" Text="PROCESSING LOG" Margin="0" VerticalAlignment="Center" />
            <Border Grid.Column="1" Margin="12,0,0,0" Background="#33ff3b6b" CornerRadius="3" Padding="7,0" VerticalAlignment="Center"
                    IsVisible="{Binding HasLogErrors}">
              <TextBlock Text="{Binding LogErrorCount, StringFormat='{}{0} error(s)'}" Foreground="{StaticResource Red}" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
              <Button Classes="link" Content="Copy" Command="{Binding CopyLogCommand}" ToolTip.Tip="Copy the log text" />
              <Button Classes="link" Content="Clear" Command="{Binding ClearLogCommand}" ToolTip.Tip="Clears this view only; the log file keeps everything" />
              <Button Classes="link" Content="Log folder" Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open the folder with the full log file" />
              <Button Classes="link" Content="Pop out" Command="{Binding PopOutLogCommand}" ToolTip.Tip="Open in its own window" />
              <Button Classes="link" Content="✕" Margin="0" Command="{Binding ToggleLogCommand}" ToolTip.Tip="Hide the log" />
            </StackPanel>
          </Grid>
          <ScrollViewer x:Name="LogScroll" Padding="18,0,18,8">
            <ItemsControl ItemsSource="{Binding LogEntries}" ItemTemplate="{StaticResource LogEntryTemplate}" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22*" MinWidth="310" />
          <ColumnDefinition Width="78*" />
        </Grid.ColumnDefinitions>

        <!-- left: grouped save list -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6" Spacing="8">
              <!-- the ✕ shows once there's something to clear; Esc in the box does the same -->
              <TextBox Text="{Binding SearchText}" Watermark="Search saves, quests, places">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.KeyBindings>
                <TextBox.InnerRightContent>
                  <Button Classes="clearSearch" Command="{Binding ClearSearchCommand}" ToolTip.Tip="Clear search"
                          IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Path Classes="glyph" Data="M0 0 L9 9 M9 0 L0 9" />
                  </Button>
                </TextBox.InnerRightContent>
              </TextBox>
              <WrapPanel>
                <Button Classes="link" Content="All" Command="{Binding SelectAllCommand}" />
                <Button Classes="link" Content="None" Command="{Binding SelectNoneCommand}" />
                <Button Classes="link" Content="Tagged" Command="{Binding SelectTaggedCommand}" />
                <Button Classes="link" Content="Invert" Command="{Binding InvertSelectionCommand}" />
              </WrapPanel>
              <!-- a filter (what the list shows), separate from the selection links above (what's ticked) -->
              <StackPanel Orientation="Horizontal">
                <Button Classes="seg" Classes.on="{Binding IsFilterAll}" Content="Show all" Command="{Binding ShowAllCommand}" />
                <Button Classes="seg starFilter" Classes.on="{Binding IsFilterStarred}" Content="{Binding StarredLabel}" Command="{Binding ShowStarredCommand}"
                        ToolTip.Tip="Only starred saves" />
                <Button Classes="seg" Classes.on="{Binding IsFilterRenamed}" Content="{Binding RenamedLabel}" Command="{Binding ShowRenamedCommand}"
                        ToolTip.Tip="Only saves with a name of their own" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="faint" Text="{Binding CheckedCount, StringFormat='{}{0} selected'}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Classes="link" Content="Expand all" Command="{Binding ExpandAllCommand}" />
                  <Button Classes="link" Content="Collapse all" Command="{Binding CollapseAllCommand}" Margin="0" />
                </StackPanel>
              </Grid>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding NoMatches}" Classes="muted" Margin="14,10" TextWrapping="Wrap"
                       Text="{Binding NoMatchesText}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.DataTemplates>

                  <DataTemplate DataType="vm:PlaythroughGroupViewModel">
                    <Panel>
                      <Button Classes="row group" Command="{Binding ToggleExpandedCommand}">
                        <!-- right padding keeps the arrow well clear of the floating scrollbar (14 px lane), so a click aimed at the
                             thumb that lands a little short hits empty space instead of toggling the group -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8,26,8">
                          <CheckBox IsThreeState="True" IsChecked="{Binding CheckState}" VerticalAlignment="Top" MinWidth="0" Margin="0,-4,4,0"
                                    ToolTip.Tip="Select the whole playthrough" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadFont}" FontSize="13" Foreground="{StaticResource PinkSoft}" />
                              <TextBlock Text="{Binding CountLabel}" Classes="faint" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding StarCount, StringFormat='★ {0}'}" Foreground="{StaticResource Amber}" FontSize="13"
                                         VerticalAlignment="Center" IsVisible="{Binding HasStars}" ToolTip.Tip="Starred saves in this playthrough" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatsLine}" Classes="faint" />
                            <TextBlock Text="{Binding LatestLine}" Classes="faint" />
                          </StackPanel>
                          <Panel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="▾" Foreground="{StaticResource Cyan}" IsVisible="{Binding IsOpen}" FontSize="16" />
                            <TextBlock Text="▸" Foreground="{StaticResource Faint}" IsVisible="{Binding !IsOpen}" FontSize="16" />
                          </Panel>
                        </Grid>
                      </Button>
                      <!-- dead strip next to the floating scrollbar: a click aimed at the thumb that lands short does nothing -->
                      <Border Width="22" HorizontalAlignment="Right" Background="Transparent" />
                    </Panel>
                  </DataTemplate>

                  <DataTemplate DataType="vm:SaveItemViewModel">
                    <Panel>
                      <Button Classes="row" Classes.focused="{Binding IsFocused}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).FocusSaveCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*" Margin="24,6,26,6">
                          <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" MinWidth="0" Margin="0,-4,4,0" />
                          <StackPanel Grid.Column="1" Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <!-- ★ when starred; on other rows a faint ☆ shows on hover -->
                              <Button Grid.Column="1" Classes="star" Classes.on="{Binding IsStarred}" ToolTip.Tip="{Binding StarTip}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleStarCommand}" CommandParameter="{Binding}">
                                <Panel>
                                  <TextBlock Text="★" IsVisible="{Binding IsStarred}" />
                                  <TextBlock Text="☆" IsVisible="{Binding !IsStarred}" />
                                </Panel>
                              </Button>
                              <TextBlock Grid.Column="2" Text="⟲" IsVisible="{Binding HasBackups}" Foreground="{StaticResource Muted}"
                                         Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Has backups" />
                              <Ellipse Grid.Column="3" Width="9" Height="9" VerticalAlignment="Center"
                                       Fill="{Binding State, Converter={StaticResource StateBrush}}" ToolTip.Tip="{Binding StateLabel}" />
                            </Grid>
                            <TextBlock Text="{Binding WasLine}" Foreground="{StaticResource Cyan}" FontSize="12" IsVisible="{Binding IsRenamed}" />
                            <TextBlock Text="{Binding ListLine}" Classes="faint" />
                            <TextBlock Text="{Binding TrackedQuest}" Classes="faint" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding MatchHint, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <TextBlock Text="{Binding MatchHint}" Foreground="{StaticResource Cyan}" FontSize="13" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding MatchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <!-- dead strip next to the floating scrollbar: a click aimed at the thumb that lands short does nothing -->
                      <Border Width="22" HorizontalAlignment="Right" Background="Transparent" />
                    </Panel>
                  </DataTemplate>

                </ItemsControl.DataTemplates>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- right: detail / batch -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <Panel Margin="26,20,26,26">

            <TextBlock Classes="muted" Text="{x:Static vm:DisclaimerText.EmptyState}" TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Left" IsVisible="{Binding ShowEmptyState}" />

            <!-- no saves where we looked: say so plainly and offer the way out -->
            <Border Classes="card" BorderBrush="{StaticResource Amber}" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="22,18" IsVisible="{Binding ShowNoSaves}">
              <StackPanel Spacing="12">
                <TextBlock Classes="h1" FontSize="18" Text="NO SAVES FOUND" />
                <TextBlock Text="{Binding NoSavesMessage}" TextWrapping="Wrap" LineHeight="21" />
                <TextBlock Classes="faint" TextWrapping="Wrap"
                           Text="Usually: Saved Games\CD Projekt Red\Cyberpunk 2077 on Windows, or the game's Proton prefix on Linux and Steam Deck." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="primary" Content="Choose folder" Command="{Binding ChangeFolderCommand}" />
                  <Button Content="Use default" Command="{Binding UseDefaultFolderCommand}" IsVisible="{Binding IsCustomFolder}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- single save -->
            <Panel IsVisible="{Binding IsSingle}">
            <StackPanel Spacing="16" MaxWidth="1180" HorizontalAlignment="Stretch"
                        DataContext="{Binding Focused}" x:DataType="vm:SaveItemViewModel">
              <Grid ColumnDefinitions="Auto,*">
                <!-- the image is clipped to the rounded shape and the frame is drawn on top of it: with the frame on the
                     same Border, the picture's square corners covered the rounded line at each corner -->
                <Panel Width="384" Height="216">
                  <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource Card}">
                    <Image Source="{Binding ScreenshotPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill" />
                  </Border>
                  <Border CornerRadius="6" BorderBrush="{StaticResource Purple}" BorderThickness="1" IsHitTestVisible="False" />
                </Panel>
                <StackPanel Grid.Column="1" Margin="22,2,0,0" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="h1" Text="{Binding Name}" />
                    <Button Classes="star big" Classes.on="{Binding IsStarred}" ToolTip.Tip="{Binding StarTip}" VerticalAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleStarCommand}" CommandParameter="{Binding}">
                      <Panel>
                        <TextBlock Text="★" IsVisible="{Binding IsStarred}" />
                        <TextBlock Text="☆" IsVisible="{Binding !IsStarred}" />
                      </Panel>
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsRenamed}" Margin="0,-6,0,0">
                    <TextBlock Classes="faint" Text="{Binding RenamedFromLine}" VerticalAlignment="Center" />
                    <Button Classes="link" Content="Reset name" VerticalAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResetNameCommand}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding MetaLine}" FontSize="16" />
                  <ItemsControl ItemsSource="{Binding Pills}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="pill"><TextBlock Text="{Binding}" /></Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="{Binding State, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Classes="link" Content="Rename…" Margin="0"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RenameFocusedCommand}"
                            ToolTip.Tip="Change the name shown in the game's Load menu" />
                    <Button Classes="link" Content="Keep this autosave…" Margin="0" IsVisible="{Binding IsInRotatingSlot}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).KeepAutosaveCommand}"
                            ToolTip.Tip="Move it out of the slot the game reuses" />
                    <Button Classes="link" Content="Open save folder" Margin="0"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenFocusedFolderCommand}" />
                    <Button Classes="link danger" Content="Delete…" Margin="0"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteFocusedCommand}"
                            ToolTip.Tip="Move to the trash" />
                  </StackPanel>
                  <Border Classes="hint" IsVisible="{Binding IsInRotatingSlot}" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Amber}"
                               Text="The game reuses this slot for later saves." />
                  </Border>
                </StackPanel>
              </Grid>

              <UniformGrid Columns="4">
                <Border Classes="metric" Margin="0,0,10,0"><StackPanel><TextBlock Classes="label" Text="Playtime" /><TextBlock Classes="value" Text="{Binding PlayTime}" /></StackPanel></Border>
                <Border Classes="metric" Margin="0,0,10,0"><StackPanel><TextBlock Classes="label" Text="Level" /><TextBlock Classes="value" Text="{Binding Level}" /></StackPanel></Border>
                <Border Classes="metric" Margin="0,0,10,0"><StackPanel><TextBlock Classes="label" Text="Street cred" /><TextBlock Classes="value" Text="{Binding StreetCred}" /></StackPanel></Border>
                <Border Classes="metric"><StackPanel><TextBlock Classes="label" Text="Lifepath" /><TextBlock Classes="value" Text="{Binding LifePath}" /></StackPanel></Border>
              </UniformGrid>

              <Grid ColumnDefinitions="*,*">
                <Border Classes="card" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Classes="h2" Text="ATTRIBUTES" />
                    <Grid ColumnDefinitions="110,*,34" RowDefinitions="26,26,26,26,26">
                      <TextBlock Grid.Row="0" Classes="muted" Text="Body" VerticalAlignment="Center" />
                      <ProgressBar Grid.Row="0" Grid.Column="1" Classes="attr" Maximum="20" Value="{Binding Body}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Classes="muted" Text="Reflexes" VerticalAlignment="Center" />
                      <ProgressBar Grid.Row="1" Grid.Column="1" Classes="attr" Maximum="20" Value="{Binding Reflexes}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Reflexes}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Classes="muted" Text="Technical" VerticalAlignment="Center" />
                      <ProgressBar Grid.Row="2" Grid.Column="1" Classes="attr" Maximum="20" Value="{Binding Tech}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Tech}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="3" Classes="muted" Text="Intelligence" VerticalAlignment="Center" />
                      <ProgressBar Grid.Row="3" Grid.Column="1" Classes="attr" Maximum="20" Value="{Binding Intelligence}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Intelligence}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="4" Classes="muted" Text="Cool" VerticalAlignment="Center" />
                      <ProgressBar Grid.Row="4" Grid.Column="1" Classes="attr" Maximum="20" Value="{Binding Cool}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Cool}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Margin="6,0,0,0">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="PROGRESS" />
                    <TextBlock Classes="label" Text="Tracked quest" />
                    <TextBlock Text="{Binding TrackedQuest}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Objective}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding Objective, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="label" Text="Main quest" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding MainQuest}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="Finished quests" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding FinishedQuests}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="card" Classes.tagged="{Binding IsTagged}" Classes.clean="{Binding IsClean}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" Text="{Binding StateDetail}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Content="Clean tag" IsVisible="{Binding IsTagged}" VerticalAlignment="Center"
                          ToolTip.Tip="Backs up the save, then removes the tag"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CleanFocusedCommand}" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                <TextBlock Classes="h2" Text="BACKUPS" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Margin="0,0,16,0" VerticalAlignment="Center"
                        Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).UndoLastBatchText}"
                        IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanUndoLastBatch}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UndoLastBatchCommand}" />
                <Button Grid.Column="2" Content="Back up now" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).BackupCheckedCommand}" />
              </Grid>
              <TextBlock Classes="faint" IsVisible="{Binding !HasBackups}" TextWrapping="Wrap"
                         Text="No backups yet." />
              <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).FocusedBackups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupItemViewModel">
                    <Border Classes="card" Width="340" Margin="0,0,12,12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <!-- kept no matter what: never offered by "Clean up backups" -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsProtected}">
                          <Border Classes="badge original" IsVisible="{Binding IsOriginal}"
                                  ToolTip.Tip="The save from before the app changed it. Always kept.">
                            <TextBlock Text="ORIGINAL" />
                          </Border>
                          <Border Classes="badge manual" IsVisible="{Binding IsManual}" ToolTip.Tip="Made with Back up. Always kept.">
                            <TextBlock Text="MANUAL" />
                          </Border>
                          <Border Classes="badge undo" IsVisible="{Binding IsUndo}" ToolTip.Tip="Needed to undo the last batch">
                            <TextBlock Text="UNDO" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DiffSummary}" Classes="faint" Foreground="{Binding HasDifferences, Converter={StaticResource DiffBrush}}" />
                        <TextBlock Text="{Binding OtherFolderNote}" Foreground="{StaticResource Amber}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding IsFromOtherFolder}" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompareField">
                              <Border Classes="fieldRow" Classes.differs="{Binding Differs}">
                                <Grid ColumnDefinitions="110,*">
                                  <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Value}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                          <Button Classes="primary" Content="Restore this"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}" />
                          <Button Classes="danger" Content="Delete"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteBackupCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- one tooltip explains every value on the line, wherever you hover -->
              <Border Background="Transparent" HorizontalAlignment="Left" ToolTip.ShowDelay="250" Cursor="Help">
                <ToolTip.Tip>
                  <ItemsControl ItemsSource="{Binding BuildDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TechDetail">
                        <StackPanel Margin="0,3">
                          <TextBlock>
                            <Run Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource PinkSoft}" />
                            <Run Text="  " />
                            <Run Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Text}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ToolTip.Tip>
                <TextBlock Classes="mono" Foreground="{StaticResource Faint}" Text="{Binding BuildLine}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            </Panel>

            <!-- batch -->
            <StackPanel Spacing="16" MaxWidth="1180" IsVisible="{Binding IsBatch}">
              <TextBlock Classes="h1" Text="{Binding CheckedCount, StringFormat='{}{0} saves selected'}" />
              <UniformGrid Columns="4">
                <Border Classes="metric" Margin="0,0,10,0"><StackPanel><TextBlock Classes="label" Text="To clean" /><TextBlock Classes="value" Foreground="{StaticResource Red}" Text="{Binding BatchToClean}" /></StackPanel></Border>
                <Border Classes="metric" Margin="0,0,10,0"><StackPanel><TextBlock Classes="label" Text="Already clean, skipped" /><TextBlock Classes="value" Foreground="{StaticResource Green}" Text="{Binding BatchClean}" /></StackPanel></Border>
                <Border Classes="metric" Margin="0,0,10,0"><StackPanel><TextBlock Classes="label" Text="Playthroughs" /><TextBlock Classes="value" Text="{Binding BatchPlaythroughs}" /></StackPanel></Border>
                <Border Classes="metric"><StackPanel><TextBlock Classes="label" Text="With backups" /><TextBlock Classes="value" Text="{Binding BatchWithBackups}" /></StackPanel></Border>
              </UniformGrid>

              <TextBlock Classes="h2" Text="BATCH ACTIONS" Margin="0,6,0,0" />
              <Border Classes="card" BorderBrush="{StaticResource Pink}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Clean modded tag" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" TextWrapping="Wrap">
                      <Run Text="{Binding BatchToClean}" /><Run Text=" tagged saves, each backed up first." />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Content="Run" VerticalAlignment="Center" Command="{Binding CleanCheckedCommand}" />
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Back up" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Back up each selected save." />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Run" VerticalAlignment="Center" Command="{Binding BackupCheckedCommand}" />
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Restore" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" TextWrapping="Wrap">
                      <Run Text="{Binding BatchWithBackups}" /><Run Text=" of the selected saves have backups." />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Review…" VerticalAlignment="Center" Command="{Binding RestoreCheckedCommand}" />
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Star" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Star or unstar the selected saves." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="★ Star" Command="{Binding StarCheckedCommand}" />
                    <Button Content="Unstar" Command="{Binding UnstarCheckedCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Delete" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Move the selected saves to the trash." />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="danger" Content="Delete…" VerticalAlignment="Center" Command="{Binding DeleteCheckedCommand}" />
                </Grid>
              </Border>
              <Border Classes="card" IsVisible="{Binding CanUndoLastBatch}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Undo last batch" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UndoLastBatchText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Review…" VerticalAlignment="Center" Command="{Binding UndoLastBatchCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="h2" Text="SELECTION" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding CheckedItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaveItemViewModel">
                    <Border Classes="pill">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="faint" Text="{Binding CheckedMore}" Margin="0,-8,0,0"
                         IsVisible="{Binding CheckedMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

          </Panel>
        </ScrollViewer>

        <!-- full music player: slides up from the status bar's mini player -->
        <Border x:Name="MusicPanel" Grid.ColumnSpan="2" Classes="musicPanel" Classes.open="{Binding IsMusicPanelOpen}" IsHitTestVisible="{Binding IsMusicPanelOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,70,0"
                Background="{StaticResource Card}" BorderBrush="#b63590" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="18,14">
                  <StackPanel Width="280" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" Text="MUSIC" Margin="0" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="✕" Margin="0" Command="{Binding ToggleMusicPanelCommand}" ToolTip.Tip="Hide the player" />
                    </Grid>
                    <StackPanel Spacing="12" IsVisible="{Binding MusicAvailable}">
                      <StackPanel>
                        <TextBlock Classes="label" Text="Now playing" />
                        <TextBlock FontWeight="SemiBold" FontSize="18"
                                   Text="{Binding NowPlaying, TargetNullValue='—', FallbackValue='—'}" />
                        <TextBlock Classes="faint" Text="Muted" IsVisible="{Binding MusicMuted}" />
                      </StackPanel>

                      <!-- position: click anywhere on the bar to jump there -->
                      <StackPanel Spacing="4" IsEnabled="{Binding !MusicMuted}">
                        <Border Height="14" Background="Transparent" Cursor="Hand" PointerPressed="OnSeekBarPressed">
                          <Border Height="6" CornerRadius="3" ClipToBounds="True" Background="{StaticResource CardHi}" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding TrackProgress}" Maximum="1" Foreground="{StaticResource NeonGradient}"
                                         Background="Transparent" MinHeight="6" Height="6" CornerRadius="3" />
                          </Border>
                        </Border>
                        <Grid ColumnDefinitions="*,*">
                          <TextBlock Classes="label" Text="{Binding TrackPositionText}" />
                          <TextBlock Grid.Column="1" Classes="label" Text="{Binding TrackDurationText}" HorizontalAlignment="Right" />
                        </Grid>
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" IsEnabled="{Binding !MusicMuted}">
                        <Button Classes="icon" Command="{Binding PreviousTrackCommand}" ToolTip.Tip="Previous">
                          <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                            <Path Classes="glyph" Stroke="{StaticResource Cyan}" StrokeThickness="2" Data="M6 5 V19" />
                            <Path Classes="glyph" Stroke="{StaticResource Cyan}" Fill="{StaticResource Cyan}" Data="M19 5 L9 12 L19 19 Z" />
                          </Canvas></Viewbox>
                        </Button>
                        <Button Classes="icon primary" Width="46" Height="46" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Pause / play">
                          <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                            <Path Classes="glyph" Stroke="{StaticResource PinkSoft}" StrokeThickness="3" IsVisible="{Binding !IsMusicPaused}" Data="M8 5 V19 M16 5 V19" />
                            <Path Classes="glyph" Stroke="{StaticResource PinkSoft}" Fill="{StaticResource PinkSoft}" IsVisible="{Binding IsMusicPaused}" Data="M8 5 L19 12 L8 19 Z" />
                          </Canvas></Viewbox>
                        </Button>
                        <Button Classes="icon" Command="{Binding NextTrackCommand}" ToolTip.Tip="Next track">
                          <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                            <Path Classes="glyph" Stroke="{StaticResource Cyan}" StrokeThickness="2" Data="M18 5 V19" />
                            <Path Classes="glyph" Stroke="{StaticResource Cyan}" Fill="{StaticResource Cyan}" Data="M5 5 L15 12 L5 19 Z" />
                          </Canvas></Viewbox>
                        </Button>
                      </StackPanel>

                      <Grid ColumnDefinitions="Auto,*,34">
                        <Button Classes="link" Margin="0,0,10,0" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute / unmute">
                          <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                            <Path Classes="glyph" Stroke="{StaticResource Cyan}" IsVisible="{Binding !MusicMuted}" Data="M4 9.5 H8 L13 5.5 V18.5 L8 14.5 H4 Z" />
                            <Path Classes="glyph" Stroke="{StaticResource Cyan}" IsVisible="{Binding !MusicMuted}" Data="M16 9.5 A3.5 3.5 0 0 1 16 14.5 M18.5 7 A7 7 0 0 1 18.5 17" />
                            <Path Classes="glyph" Stroke="{StaticResource Pink}" IsVisible="{Binding MusicMuted}" Data="M4 9.5 H8 L13 5.5 V18.5 L8 14.5 H4 Z M16 9.5 L21 14.5 M21 9.5 L16 14.5 M3 3 L21 21" />
                          </Canvas></Viewbox>
                        </Button>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MusicVolume}" IsEnabled="{Binding !MusicMuted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MusicVolume, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !MusicAvailable}"
                               Text="Music isn't available on this system yet." />
                  </StackPanel>
                        </Border>
      </Grid>
    </DockPanel>

    <!-- disclaimer: shown until the current terms version is ticked and accepted once (remembered in settings) -->
    <Border IsVisible="{Binding !DisclaimerAccepted}" Background="#ee040308">
      <Border Classes="card" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Pink}" Padding="30,26" Effect="drop-shadow(0 0 28 #66eb107e)">
        <StackPanel Spacing="16">
          <TextBlock Classes="h1" Text="BEFORE YOU CONTINUE" />
          <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" LineHeight="22" FontSize="15" />
          <CheckBox IsChecked="{Binding DisclaimerTicked}" Content="{x:Static vm:DisclaimerText.Accept}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Quit" Command="{Binding QuitCommand}" />
            <Button Classes="primary" Content="Continue" Command="{Binding AcceptDisclaimerCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- bulk restore / undo review: rule, the saves that have a real choice, the rest collapsed. Esc cancels -->
    <Border IsVisible="{Binding IsReviewOpen}" Background="#cc040308">
      <Border Classes="card" Width="820" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Pink}" Padding="26,22" Effect="drop-shadow(0 0 24 #66eb107e)" DataContext="{Binding Review}">
        <DockPanel x:DataType="vm:RestoreReviewViewModel">
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,14">
            <TextBlock Classes="h1" FontSize="17" Text="{Binding Heading}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Intro}" />
            <StackPanel Spacing="6" IsVisible="{Binding HasRule}">
              <TextBlock Classes="label" Text="Restore each save to" />
              <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,14,0,0">
            <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding Summary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Content="Cancel" Command="{Binding CancelCommand}" />
              <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,14,0">
              <StackPanel Spacing="6" IsVisible="{Binding HasNeedsLook}">
                <TextBlock Classes="h2" Text="CHECK THESE" />
                <ItemsControl ItemsSource="{Binding NeedsLook}" ItemTemplate="{StaticResource RestoreRowTemplate}" />
              </StackPanel>
              <Expander IsVisible="{Binding HasReady}" Header="{Binding ReadyHeader}" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Ready}" ItemTemplate="{StaticResource RestoreRowTemplate}" />
              </Expander>
              <Expander IsVisible="{Binding HasSkipped}" Header="{Binding SkippedHeader}" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Skipped}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RestoreSkip">
                      <TextBlock Margin="0,3" TextWrapping="Wrap">
                        <Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Reason}" Foreground="{StaticResource Faint}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- deleted saves: restore or delete for good. Esc closes -->
    <Border IsVisible="{Binding IsTrashOpen}" Background="#cc040308">
      <Border Classes="card" Width="760" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Pink}" Padding="26,22" Effect="drop-shadow(0 0 24 #66eb107e)" DataContext="{Binding TrashView}">
        <DockPanel x:DataType="vm:TrashViewModel">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="6">
              <TextBlock Classes="h1" FontSize="17" Text="DELETED SAVES" />
              <TextBlock Classes="muted" Text="{Binding Summary}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="link" Content="Select all" VerticalAlignment="Bottom" Command="{Binding SelectAllCommand}" IsVisible="{Binding HasRows}" />
          </Grid>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Classes="danger" Content="Empty trash" Command="{Binding EmptyCommand}" />
            <Button Classes="danger" Content="Delete permanently" Command="{Binding DeleteForeverCommand}" />
            <Button Classes="primary" Content="{Binding RestoreText}" Command="{Binding RestoreCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,14,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrashRowViewModel">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" />
                      <Panel Grid.Column="1" Width="96" Height="54" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Border CornerRadius="4" ClipToBounds="True" Background="{StaticResource CardHi}">
                          <Image Source="{Binding ScreenshotPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill" />
                        </Border>
                        <Border CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False" />
                      </Panel>
                      <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Quest}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Line}" Classes="faint" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding DeletedLine}" Classes="faint" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- rename / keep this autosave: the name, checked as you type. Enter renames, Esc cancels -->
    <Border IsVisible="{Binding IsRenameOpen}" Background="#cc040308">
      <Border Classes="card" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Pink}" Padding="26,22" Effect="drop-shadow(0 0 24 #66eb107e)" DataContext="{Binding RenameDialog}">
        <StackPanel Spacing="10" x:DataType="vm:RenameDialogViewModel">
          <TextBlock Classes="h1" FontSize="17" Text="{Binding Heading}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Intro}" />
          <TextBlock Classes="label" Text="Name" Margin="0,6,0,0" />
          <TextBox x:Name="RenameBox" Text="{Binding Name}" MaxLength="60">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerRightContent>
              <TextBlock Text="{Binding Counter}" Classes="faint" VerticalAlignment="Center" Margin="0,0,10,0" />
            </TextBox.InnerRightContent>
          </TextBox>
          <TextBlock Text="✓ Available" Foreground="{StaticResource Green}" FontSize="13" IsVisible="{Binding IsValid}" />
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource Red}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding !IsValid}" />
          <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding OriginalNote}"
                     IsVisible="{Binding OriginalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Foreground="{StaticResource Amber}" FontSize="13" TextWrapping="Wrap" Text="{Binding CloudNote}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="primary" Content="Rename" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- clean up backups: groups of backups that can go, each ticked as a whole. Esc cancels -->
    <Border IsVisible="{Binding IsCleanupOpen}" Background="#cc040308">
      <Border Classes="card" Width="760" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Pink}" Padding="26,22" Effect="drop-shadow(0 0 24 #66eb107e)" DataContext="{Binding Cleanup}">
        <DockPanel x:DataType="vm:CleanupReviewViewModel">
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <TextBlock Classes="h1" FontSize="17" Text="CLEAN UP BACKUPS" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding KeptText}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,14,0,0">
            <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding Summary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Content="Cancel" Command="{Binding CancelCommand}" />
              <Button Classes="danger" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,14,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupGroupViewModel">
                  <Border Classes="card" Margin="0,0,0,10" Padding="16,12">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <CheckBox IsChecked="{Binding IsChecked}" FontWeight="SemiBold" Content="{Binding Title}" />
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource PinkSoft}" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Description}" Margin="28,0,0,0" />
                      <Expander Header="{Binding ShowText}" Margin="28,4,0,0" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" Classes="faint" FontSize="13" Margin="0,1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- confirm / alert dialogs, drawn in the window over a dimmed page (MainWindow.ShowDialogAsync). Enter / Esc -->
    <Border x:Name="DialogLayer" IsVisible="False" Background="#cc040308">
      <Border Classes="card" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Pink}" Padding="26,22" Effect="drop-shadow(0 0 24 #66eb107e)">
        <StackPanel Spacing="16">
          <TextBlock x:Name="DialogTitle" Classes="h1" FontSize="17" />
          <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" LineHeight="21" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="DialogCancel" Content="Cancel" Click="OnDialogCancel" />
            <Button x:Name="DialogConfirm" Classes="primary" Click="OnDialogConfirm" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
      </Panel>
    </DockPanel>

    <!-- intro: ~2.6 s on every launch, click or any key skips. Animated from MainWindow.axaml.cs -->
    <Border x:Name="Intro" Background="#000000" Cursor="Hand">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <Panel x:Name="IntroName" Opacity="0" HorizontalAlignment="Center">
          <TextBlock x:Name="IntroNameGlowXL" Text="NMST" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="72"
                     Foreground="#eb107e" HorizontalAlignment="Center" Effect="blur(40)" />
          <TextBlock x:Name="IntroNameGlowWide" Text="NMST" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="72"
                     Foreground="#eb107e" HorizontalAlignment="Center" Effect="blur(16)" />
          <TextBlock x:Name="IntroNameGlow" Text="NMST" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="72"
                     Foreground="#eb107e" HorizontalAlignment="Center" Effect="blur(5)" />
          <TextBlock Text="NMST" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="72"
                     Foreground="#fff4fa" HorizontalAlignment="Center" />
        </Panel>
        <TextBlock x:Name="IntroSub" Text="MODDED SAVE CLEANER" FontFamily="{StaticResource HeadFont}" FontSize="18" LetterSpacing="6"
                   Foreground="#ffdaec" HorizontalAlignment="Center" Opacity="0" Effect="drop-shadow(0 0 8 #eb107e)" />
        <Panel x:Name="IntroBy" Opacity="0" HorizontalAlignment="Center" Margin="0,30,0,0">
          <TextBlock x:Name="IntroByGlowXL" Text="strife//art" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="22"
                     Foreground="#e60073" HorizontalAlignment="Center" Effect="blur(30)" />
          <TextBlock x:Name="IntroByGlowWide" Text="strife//art" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="22"
                     Foreground="#e60073" HorizontalAlignment="Center" Effect="blur(14)" />
          <TextBlock x:Name="IntroByGlow" Text="strife//art" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="22"
                     Foreground="#e60073" HorizontalAlignment="Center" Effect="blur(4)" />
          <TextBlock Text="strife//art" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="22"
                     Foreground="White" HorizontalAlignment="Center" />
        </Panel>
      </StackPanel>
    </Border>
  </Panel>
</Window>
